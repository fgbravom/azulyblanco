# Copiar a website/.env.local (ver CONTRIBUTING.md). Nunca se sube a git.

# Supabase. En local, copiar los valores que muestra `npm run db:status`
# (API URL, anon key y service_role key) después de `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firma la cookie de sesión del admin. Cualquier texto largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hash bcrypt (en base64) de la contraseña del admin. Obligatorio en producción.
# En local se puede dejar vacío: rige la contraseña de desarrollo (ver CONTRIBUTING.md).
ADMIN_PASSWORD_HASH=

# Opcionales
# NEXT_PUBLIC_SITE_URL=https://www.azulyblanco.cl
# CUOTAS_HABILITADAS=true   # muestra el sistema de cuotas (Docs/CUOTAS.md)

# Email del formulario de contacto (https://resend.com). Sin esta clave, en
# producción el formulario muestra el respaldo de correo directo; en local el
# mensaje se registra en la consola del servidor. Para enviar de verdad hay que
# crear la API key y verificar el dominio azulyblanco.cl en Resend.
RESEND_API_KEY=
